rules_version = '2';

// The Angular frontend never talks to Firestore directly -- it only calls
// the Cloud Functions API (which uses the Admin SDK and bypasses these
// rules entirely). So client access is denied outright; this just prevents
// anyone from reading/writing the catalogue straight from a browser SDK.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
